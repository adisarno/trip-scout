RESEND_API_KEY=re_replace_me
# Test sender: EMAIL_TO must be the email associated with your Resend account.
# Or reuse your verified sender domain from job-scraper.
EMAIL_FROM=Trip Scout <onboarding@resend.dev>
EMAIL_TO=you@example.com
ORIGIN_AIRPORTS=FCO,CIA
# Google Flights Deals via SerpApi (third-party API, not Google's official API).
SERPAPI_API_KEY=
# Optional editorial summary; never used to invent or estimate prices.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
ENABLE_LLM_SUMMARY=false
# Required for encrypted Actions state/reports, optional for local scans.
# Generate a NEW 32-byte base64 key; back it up privately (see docs/privacy.md).
STATE_ENCRYPTION_KEY=
